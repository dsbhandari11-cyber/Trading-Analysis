# Bhandari Trading Analysis Dashboard — Environment Variables
# Copy this file to .env and fill in values as needed.
# All keys are optional. The app works without any API keys.

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: NewsAPI key for additional headlines (https://newsapi.org)
NEWS_API_KEY=

# Optional: override auto-refresh interval in seconds (default 60)
REFRESH_INTERVAL=60
